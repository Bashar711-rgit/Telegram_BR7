      "review": { "min": 0.40, "max": 0.65, "action": "review" },
      "accept": { "min": 0.65, "max": 1.0, "action": "accept" }
    },
    "fixes_changelog": [
      "== v15.5.0 — Complete deterministic rule engine redesign ==",
      "27) [P0] Negation detection now runs BEFORE compound matching",
      "28) [P0] Compound requests are rules with explicit priority, not bypasses",
      "29) [P0] Forbidden rules with unless_any conditions are loaded from JSON",
      "30) [P0] Signal deduplication prevents double-counting (request_phrase contains intent_verb)",
      "31) [P0] min_confidence/decision/priority loaded from JSON, not hard-coded",
      "32) [P1] Question/interrogative detection added as context modifier",
      "33) [P1] Quotation/mention detection prevents quoted text from matching",
      "34) [P1] Boost patterns cannot override Hard Gate rejection"
    ]
  },

